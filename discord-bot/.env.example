# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_bot_client_id_here
DISCORD_GUILD_ID=your_server_id_here
DISCORD_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# Роль которая выдается при привязке Discord (ID роли)
DISCORD_VERIFIED_ROLE_ID=your_role_id_here

# Роль которая выдается при первом пополнении баланса (ID роли)
DISCORD_BUYER_ROLE_ID=your_buyer_role_id_here

# URL сайта биллинга
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (копируйте из основного .env)
DATABASE_URL="mysql://fluxor:password@localhost:3306/fluxor"

# Bot Settings
BOT_PREFIX=!
# Discord ID администраторов через запятую (могут вызывать команду /status)
ADMIN_DISCORD_IDS=123456789012345678,987654321098765432

# Discord Notification Channels
# Укажите ID каналов для отправки уведомлений
# Чтобы получить ID канала: Настройки Discord -> Продвинутые -> Режим разработчика
# Затем ПКМ на канал -> Копировать ID
DISCORD_LOG_CHANNEL_ID=""                # Общий канал логов (если не указаны специфичные каналы)
DISCORD_BALANCE_LOG_CHANNEL_ID=""        # Канал для логов пополнений баланса
DISCORD_SERVER_LOG_CHANNEL_ID=""         # Канал для логов создания/удаления серверов
DISCORD_USER_LOG_CHANNEL_ID=""           # Канал для логов пользователей (регистрация, вход)
DISCORD_ADMIN_LOG_CHANNEL_ID=""          # Канал для админских действий (ВАЖНО!)
DISCORD_APPEAL_CHANNEL_ID=""             # Канал для апелляций на разбан

# Webhook Server Settings
DISCORD_BOT_WEBHOOK_PORT=3001            # Порт для HTTP сервера webhook
INTERNAL_WEBHOOK_SECRET="fluxor-internal-webhook"  # Секретный ключ для внутренних запросов

