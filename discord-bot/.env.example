# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_bot_client_id_here
DISCORD_GUILD_ID=your_server_id_here

# Роль которая выдается при привязке Discord (ID роли)
DISCORD_VERIFIED_ROLE_ID=your_role_id_here

# URL сайта биллинга
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (копируйте из основного .env)
DATABASE_URL="mysql://avelon:password@localhost:3306/avelon"

# Bot Settings
BOT_PREFIX=!
ADMIN_DISCORD_IDS=123456789012345678,987654321098765432
